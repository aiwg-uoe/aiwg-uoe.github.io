---
import Site from '../layouts/Site.astro';
---
<Site title="News &amp; Events">
  <div class="reading">
    <h1>News &amp; Events</h1>
    <ul aria-label="On this page">
      <li><a href="#latest-news">Latest news</a></li>
      <li><a href="#upcoming-events">Upcoming events</a></li>
      <li><a href="#past-events">Past events</a></li>
      <li><a href="#blogs-and-stories">Blogs and stories</a></li>
    </ul>
    <section aria-labelledby="latest-news">
      <h2 id="latest-news">Latest news</h2>
      <p><a href={import.meta.env.BASE_URL + "news/"}>Browse news</a>.</p>
    </section>
    <section aria-labelledby="upcoming-events">
      <h2 id="upcoming-events">Upcoming events</h2>
      <p><a href={import.meta.env.BASE_URL + "events/"}>Browse events</a>.</p>
    </section>
    <section aria-labelledby="past-events">
      <h2 id="past-events">Past events</h2>
      <p>Past event listings have yet to be posted here.</p>
    </section>
    <section aria-labelledby="blogs-and-stories">
      <h2 id="blogs-and-stories">Blogs and stories</h2>
      <p>Blogs and stories have yet to be posted here.</p>
    </section>
  </div>
</Site>
