---
import Site from '../layouts/Site.astro';
---
<Site title="Accessibility and Inclusivity working group">
<section class="hero">
  <h1 class="group-name">Accessibility
    <span class="name-second"><span class="name-amp">&amp;</span> Inclusivity</span>
    <span class="name-suffix">Working Group</span></h1>
<img class="hero-art" src={import.meta.env.BASE_URL + "group-discussion.webp"} width="1200" height="800" alt="Nine people of different generations gather in conversation. Two sign to each other, a wheelchair user holds a tablet, and a child talks with an older person using a white cane." /></section>
<section class="aim">
  <h2>Our Aim</h2>
  <p>We aim to remove barriers to participation and make sure the people who encounter them help shape the decisions that affect them.</p>
</section>
